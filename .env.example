# ============================================================
# CS-BOT Photobooth Server Environment Variables
# ============================================================

# Server Port
PORT=3000

# SMTP Configuration (Example: Gmail, Outlook, Brevo, SendGrid, Mailgun, or custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="IEEE ENIS CS SBC <your-email@gmail.com>"

# Optional: Email Subject & Brand Name
EMAIL_SUBJECT="📸 Your IEEE ENIS CS SBC Photobooth Souvenir!"
